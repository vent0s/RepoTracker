<Window x:Class="RepoTracker.Desktop.RepositoryDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:RepoTracker.Desktop.Localization"
        Title="{l10n:Text Repository.ScanTitle}" Width="660" Height="620" MinWidth="480" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}"
        AutomationProperties.AutomationId="RepositoryDiscovery">
  <Grid Margin="24" LayoutTransform="{DynamicResource UiScaleTransform}" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="{l10n:Text Repository.ScanTitle}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{l10n:Text Repository.ScanHint}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
      <TextBlock x:Name="Summary" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ScanSummary" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <ItemsControl x:Name="Results" AutomationProperties.AutomationId="ScanResults">
          <ItemsControl.ItemTemplate><DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Checked="SelectionChanged" Unchecked="SelectionChanged"
                      Margin="0,6,12,6" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Path}" AutomationProperties.AutomationId="SelectRepository">
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Path}" Margin="0,4,0,0" Foreground="{DynamicResource DimBrush}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Warnings" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="SelectionSummary" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{l10n:Text Action.Cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0" AutomationProperties.AutomationId="Cancel" />
        <Button x:Name="ImportButton" Content="{l10n:Text Repository.ImportSelected}" IsDefault="True" IsEnabled="False" Click="Import"
                Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.AutomationId="ImportRepositories" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
