<Window x:Class="RepoTracker.Desktop.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:RepoTracker.Desktop.Localization"
        Width="500" Height="400" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Style="{StaticResource {x:Type Window}}" AutomationProperties.AutomationId="EntryDialog">
  <Grid Margin="24" LayoutTransform="{DynamicResource UiScaleTransform}" KeyboardNavigation.TabNavigation="Cycle">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Width="{Binding ViewportWidth, ElementName=FieldsScroll}" MinWidth="320">
    <StackPanel>
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="Description" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>
    <StackPanel Margin="0,18,0,12">
      <StackPanel x:Name="Fields">
        <TextBlock x:Name="InputLabel" Margin="0,0,0,8" />
        <DockPanel x:Name="InputRow">
          <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="{l10n:Text Action.Browse}" Margin="8,0,0,0" Click="Browse" AutomationProperties.AutomationId="Browse" />
          <TextBox x:Name="InputBox" VerticalContentAlignment="Center" MinHeight="36" AutomationProperties.AutomationId="EntryText" />
        </DockPanel>
        <StackPanel x:Name="ChoiceRow" Margin="0,16,0,0">
          <TextBlock Text="{l10n:Text Group.Assigned}" Margin="0,0,0,8" />
          <ComboBox x:Name="ChoicesBox" MinHeight="36" SelectedValuePath="Id" AutomationProperties.Name="{l10n:Text Group.Assigned}" AutomationProperties.AutomationId="GroupChoice">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <CheckBox x:Name="ScanChildrenBox" Content="{l10n:Text Repository.ScanOnAdd}" Visibility="Collapsed" IsChecked="True"
                  Margin="0,16,0,0" AutomationProperties.AutomationId="ScanChildrenOnAdd" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{l10n:Text Action.Cancel}" IsCancel="True" MinWidth="80" Margin="0,0,8,0" AutomationProperties.AutomationId="Cancel" />
      <Button x:Name="SubmitButton" Content="{l10n:Text Action.Save}" IsDefault="True" MinWidth="92" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" Click="Submit" AutomationProperties.AutomationId="Submit" />
    </StackPanel>
  </Grid>
</Window>
