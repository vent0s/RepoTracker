<Window x:Class="RepoTracker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:RepoTracker.Desktop.Localization"
        xmlns:vm="clr-namespace:RepoTracker.Desktop.ViewModels"
        Title="RepoTracker" Width="760" Height="760" ResizeMode="CanMinimize" Style="{StaticResource {x:Type Window}}"
        ShowInTaskbar="True" Icon="{StaticResource AppIcon}" WindowStartupLocation="Manual"
        AutomationProperties.AutomationId="MainPanel">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="76" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:RepositoryRow}">
      <Border Height="76" Padding="{Binding TreePadding}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Border.Style><Style TargetType="Border"><Style.Triggers>
          <DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter Property="Background" Value="{DynamicResource NoticeBrush}" /></DataTrigger>
        </Style.Triggers></Style></Border.Style>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="140" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
          <Button Content="{Binding ExpansionGlyph}" Style="{StaticResource IconButton}" Width="24" Padding="0" Click="ToggleRepositoryChildren"
                  Visibility="{Binding HasChildren, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ExpansionAccessibleName}"
                  IsEnabled="{Binding Model.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutomationProperties.AutomationId="ToggleRepositoryChildren" AutomationProperties.Name="{Binding ExpansionAccessibleName}" />
          <Border Grid.Column="1" Background="{DynamicResource HoverBrush}" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left">
            <Path Width="21" Height="21" Stretch="Uniform" ToolTip="{Binding SourceTooltip}" AutomationProperties.Name="{Binding SourceTooltip}" Fill="{DynamicResource MutedBrush}">
              <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource SourceGit}" /><Style.Triggers>
                <DataTrigger Binding="{Binding SourceIconKey}" Value="GitHub"><Setter Property="Data" Value="{StaticResource SourceGitHub}" /></DataTrigger>
                <DataTrigger Binding="{Binding SourceIconKey}" Value="GitLab"><Setter Property="Data" Value="{StaticResource SourceGitLab}" /></DataTrigger>
                <DataTrigger Binding="{Binding SourceIconKey}" Value="Server"><Setter Property="Data" Value="{StaticResource SourceServer}" /></DataTrigger>
                <DataTrigger Binding="{Binding SourceIconKey}" Value="Unknown"><Setter Property="Data" Value="{StaticResource SourceUnknown}" /></DataTrigger>
              </Style.Triggers></Style></Path.Style>
            </Path>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="{Binding DisplayPath}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Path}" />
            <TextBlock Text="{Binding ChildrenText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" Visibility="{Binding HasChildren, Converter={StaticResource BoolVisibility}}" />
          </StackPanel>
          <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding StatusTooltip}">
            <TextBlock Text="{Binding BranchText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding BranchDetail}" FontSize="10" Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding StatusTooltip}">
            <TextBlock Text="{Binding StatusText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Style.Triggers>
              <DataTrigger Binding="{Binding StatusTone}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding StatusTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding StatusTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="{Binding ComparisonText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FreshnessText}" FontSize="10" Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding RemoteText}" ToolTip="{Binding RemoteTooltip}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="32" Click="OpenRepositoryFolder" ToolTip="{l10n:Text Repository.Open}" AutomationProperties.Name="{Binding OpenFolderAccessibleName}" AutomationProperties.AutomationId="OpenRepository">
              <Path Data="M 1,4 L 1,2 L 7,2 L 9,4 L 17,4 L 17,14 L 1,14 Z M 1,6 L 17,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="18" Height="16" />
            </Button>
            <Button Content="&#xE712;" Style="{StaticResource IconButton}" Width="32" Click="RepositoryMenu" ToolTip="{l10n:Text Repository.ActionsHint}" AutomationProperties.Name="{Binding ActionsAccessibleName}" AutomationProperties.AutomationId="RepositoryActions" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GroupRow}">
      <Expander IsExpanded="{Binding IsExpanded, Mode=OneWay}" Expanded="GroupExpansionChanged" Collapsed="GroupExpansionChanged"
                Foreground="{DynamicResource TextBrush}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{Binding Name}">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Margin="8,4,0,4">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="270" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Text="{Binding Repositories.Count}" Foreground="{DynamicResource DimBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" IsEnabled="{Binding CanManage}"
                        Visibility="{Binding Model.ManagingGroups, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
              <Button Content="{l10n:Text Action.Rename}" Padding="8,4" Click="RenameGroup" AutomationProperties.AutomationId="RenameGroup" />
              <Button Content="{l10n:Text Action.Delete}" Padding="8,4" Click="DeleteGroup" AutomationProperties.AutomationId="DeleteGroup" />
            </StackPanel>
          </StackPanel>
        </Expander.Header>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding VisibleRepositories}" />
          <TextBlock Text="{l10n:Text Group.Empty}" Margin="32,14" Foreground="{DynamicResource DimBrush}" FontSize="12">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
              <DataTrigger Binding="{Binding Repositories.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Expander>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" LayoutTransform="{DynamicResource UiScaleTransform}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="40" /><RowDefinition Height="44" /><RowDefinition Height="30" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
      <Grid Margin="22,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{StaticResource AppIcon}" Width="34" Height="34" Margin="0,0,12,0" />
          <StackPanel>
            <TextBlock Text="RepoTracker" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{l10n:Text App.Tagline}" Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l10n:Text Status.RefreshHint}" AutomationProperties.Name="{l10n:Text Status.Refresh}" AutomationProperties.AutomationId="RefreshLocal" />
          <Button x:Name="KeepButton" Content="&#xE718;" Command="{Binding ToggleKeepCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l10n:Text Window.KeepHint}" AutomationProperties.AutomationId="KeepExpanded" AutomationProperties.Name="{l10n:Text Window.Keep}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding KeepExpanded}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
          <Button Content="&#xE713;" Style="{StaticResource IconButton}" Command="{Binding SettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l10n:Text Settings.Hint}" AutomationProperties.Name="{l10n:Text Settings.Window}" AutomationProperties.AutomationId="Settings" />
          <Button x:Name="MenuButton" Content="&#xE712;" Style="{StaticResource IconButton}" Click="OpenMenu" ToolTip="{l10n:Text Action.More}" AutomationProperties.Name="{l10n:Text Action.More}" AutomationProperties.AutomationId="More">
            <Button.ContextMenu>
              <ContextMenu x:Name="AppMenu" Opened="MenuOpened" Closed="MenuClosed">
                <MenuItem Header="{l10n:Text Settings.Window}" Click="OpenSettingsFromMenu" InputGestureText="Ctrl+," />
                <Separator />
                <MenuItem Header="{l10n:Text Window.Collapse}" Click="CollapseFromMenu" InputGestureText="Esc" />
                <MenuItem Header="{l10n:Text App.Exit}" Click="ExitFromMenu" InputGestureText="Alt+F4" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="&#xE921;" Style="{StaticResource IconButton}" Command="{Binding CollapseCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l10n:Text Window.CollapseHint}" AutomationProperties.Name="{l10n:Text Window.Collapse}" AutomationProperties.AutomationId="Collapse" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource NoticeBrush}" Padding="22,0">
        <DockPanel><Button DockPanel.Dock="Right" Content="{l10n:Text Repository.Undo}" Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding CanUndo, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="UndoRemove" /><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" /></DockPanel>
      </Border>
      <Grid Grid.Row="2" Margin="22,0">
        <TextBlock Text="{l10n:Text Group.Heading}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{l10n:Text Group.NewButton}" Command="{Binding NewGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="NewGroup" />
          <Button Command="{Binding ManageGroupsCommand, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="ManageGroups">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="{l10n:Text Group.Manage}" /><Style.Triggers><DataTrigger Binding="{Binding ManagingGroups}" Value="True"><Setter Property="Content" Value="{l10n:Text Group.FinishManaging}" /><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="3" Margin="22,0" Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="212" /></Grid.ColumnDefinitions>
        <TextBlock Text="{l10n:Text Repository.PathColumn}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11" />
        <TextBlock Grid.Column="1" Text="{l10n:Text Status.Branch}" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11" />
        <TextBlock Grid.Column="2" Text="{l10n:Text Status.WorktreeColumn}" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}" FontSize="11" />
      </Grid>
      <ScrollViewer x:Name="RepositoryScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12,4,0,0" AutomationProperties.Name="{l10n:Text Repository.List}" KeyboardNavigation.TabNavigation="Continue">
        <ItemsControl ItemsSource="{Binding Groups}" MinWidth="{Binding RepositoryListMinWidth}" Width="{Binding ViewportWidth, ElementName=RepositoryScroll}" />
      </ScrollViewer>
      <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
        <Grid>
          <Button Content="{l10n:Text Repository.AddButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" Command="{Binding ChooseFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{l10n:Text Repository.AddHint}" AutomationProperties.Name="{l10n:Text Repository.Add}" AutomationProperties.AutomationId="ChooseFolder" />
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding RemoteSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding LocalCheckSummary}" Foreground="{DynamicResource DimBrush}" FontSize="10" Margin="0,5,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
